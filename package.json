{
  "name": "scraping-lambda",
  "version": "2.0.0",
  "private": true,
  "description": "Browser-only web capture worker for Remak",
  "license": "ISC",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,yml,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,yml,md}\"",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-sqs": "^3.883.0",
    "@sparticuz/chromium": "149.0.0",
    "ipaddr.js": "^2.2.0",
    "puppeteer-core": "25.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
